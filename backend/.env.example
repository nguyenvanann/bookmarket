# —— Server ——
PORT=5002
NODE_ENV=development
# MongoDB: docker run -d -p 27017:27017 --name bm-mongo mongo:7
MONGODB_URI=mongodb://127.0.0.1:27017/bookmarket
# Origin Vite (nhiều cổng: cách nhau bằng dấu phẩy)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# —— JWT ——
# Lab: giữ mặc định. Production: openssl rand -hex 32
JWT_SECRET=bookmarket-dev-secret
JWT_EXPIRES_IN=7d

# —— Blockchain (Geth private-net · chainId 54321) ——
# Lấy RPC / deployer từ blockchain/private-net (start-node1.sh, genesis.json, .env)
# Lấy địa chỉ contract sau: cd ../smart-contract && npm run deploy:local
NETWORK_NAME=BookMarket Private
CHAIN_ID=54321
RPC_URL=http://127.0.0.1:8547
RPC_URL_2=http://127.0.0.1:8548
# Để trống hoặc chạy: cd ../smart-contract && npm run deploy:local (ghi đè tự động)
# KHÔNG copy địa chỉ mẫu cũ — sẽ làm thanh toán BAD_DATA
BOOK_NFT_ADDRESS=
BOOK_MARKETPLACE_ADDRESS=
DEPLOYER_ADDRESS=0xd18624683f144a400317Fc7ec8437a8deDeEE906
# Trùng nội dung blockchain/private-net/password.txt
GETH_PASSWORD=password
# Tuỳ chọn — để trống thì unlock qua personal_unlockAccount trên Geth
DEPLOYER_PRIVATE_KEY=

# —— Faucet ETH (lab) ——
FAUCET_AMOUNT_ETH=1
FAUCET_MAX_PUBLIC_ETH=5
FAUCET_MAX_ADMIN_ETH=100
FAUCET_SKIP_IF_BALANCE_ETH=2

# —— Hóa đơn GTGT (sales PDF) ——
VAT_RATE_PERCENT=10
ETH_VND_RATE=0
INVOICE_TEMPLATE_CODE=1
INVOICE_SYMBOL=C26TAA
INVOICE_FORM=01GTKT0/001
SELLER_LEGAL_NAME=Công ty TNHH BookMarket Việt Nam
SELLER_TAX_CODE=0312345678
SELLER_ADDRESS=Tầng 1, Tòa nhà BookMarket, Quận 1, TP. Hồ Chí Minh, Việt Nam
SELLER_PHONE=02812345678
SELLER_EMAIL=ke-toan@bookmarket.local
SELLER_BANK_ACCOUNT=
SELLER_BANK_NAME=

# —— Phiếu nhập / xuất kho (01-VT / 02-VT · TT 99/2025/TT-BTC) ——
WAREHOUSE_NAME=Kho sách NFT BookMarket
WAREHOUSE_ADDRESS=Tầng 1, Tòa nhà BookMarket, Quận 1, TP. Hồ Chí Minh
WAREHOUSE_DEPARTMENT=Bộ phận Kho vận
