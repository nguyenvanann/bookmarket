# —— API backend ——
# Tuyệt đối: http://localhost:5002/api
# Hoặc qua proxy Vite (vite.config.js): /api
VITE_API_BASE_URL=http://localhost:5002/api

# —— Mạng Geth BookMarket (MetaMask + ethers đọc chain) ——
# Lấy từ blockchain/private-net: chainId 54321, RPC :8547
VITE_NETWORK_NAME=BookMarket Private
VITE_CHAIN_ID=54321
VITE_RPC_URL=http://127.0.0.1:8547

# —— Địa chỉ contract ——
# Sau deploy: cd ../smart-contract && npm run deploy:local
# Hoặc copy từ smart-contract/deployments/localhost.json / backend/.env
# Sau deploy: npm run deploy:local trong smart-contract (ghi đè tự động)
VITE_BOOK_NFT_ADDRESS=
VITE_BOOK_MARKETPLACE_ADDRESS=
