# RPC Geth BookMarket (node1) — xem blockchain/private-net/start-node1.sh / .env
RPC_URL=http://127.0.0.1:8547

# Địa chỉ signer/miner Node 1 (alloc trong genesis.json)
DEPLOYER_ADDRESS=0xd18624683f144a400317Fc7ec8437a8deDeEE906

# Tuỳ chọn — nếu để trống, scripts/deploy.js sẽ unlock tài khoản qua
# personal_unlockAccount + password ở blockchain/private-net/password.txt
# Chỉ điền khi muốn ký bằng private key thay vì unlock geth.
DEPLOYER_PRIVATE_KEY=
